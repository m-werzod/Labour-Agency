# ----------------------------------------------------------------------------
# Specialist Group — Environment Variables
# Copy to `.env` for local development and configure the values below.
# Never commit real secrets. On Vercel, set these in Project Settings.
# ----------------------------------------------------------------------------

# Database (PostgreSQL) — Vercel Postgres / Neon / Supabase / self-hosted
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/specialist_group?schema=public"
# Direct (non-pooled) connection used by Prisma migrations on serverless providers.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/specialist_group?schema=public"

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site URL (used for SEO canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP / Nodemailer (transactional email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@specialistgroup.uz"
SMTP_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="Specialist Group <no-reply@specialistgroup.uz>"

# Internal recipients for inbound inquiries
ADMIN_EMAIL="recruitment@specialistgroup.uz"
SALES_EMAIL="sales@specialistgroup.uz"

# Feature flags
ENABLE_EMAIL="false"   # set "true" once SMTP is configured

# Seed credentials (used only by prisma/seed.ts for the first admin user)
SEED_ADMIN_EMAIL="admin@specialistgroup.uz"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
