# ----------------------------------------------------------------------------
# Specialist Group — Environment Variables
# Copy to `.env` for local development and configure the values below.
# Never commit real secrets. On Vercel, set these in Project Settings.
# ----------------------------------------------------------------------------

# Database (PostgreSQL) — Vercel Postgres / Neon / Supabase / self-hosted
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/specialist_group?schema=public"
# Direct (non-pooled) connection used by Prisma migrations on serverless providers.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/specialist_group?schema=public"

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site URL (used for SEO canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP / Nodemailer (transactional email) — Gmail
# Requires a Gmail App Password (not your regular password).
# Enable 2-Step Verification on the account, then go to:
# Google Account → Security → App Passwords → create one for "Mail".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="labourmigrationuz@gmail.com"
SMTP_PASSWORD="replace-with-gmail-app-password"
EMAIL_FROM="Specialist Group <labourmigrationuz@gmail.com>"

# Internal recipients for inbound inquiries
ADMIN_EMAIL="labourmigrationuz@gmail.com"
SALES_EMAIL="labourmigrationuz@gmail.com"

# Feature flags
ENABLE_EMAIL="true"

# Seed credentials (used only by prisma/seed.ts for the first admin user)
SEED_ADMIN_EMAIL="admin@specialistgroup.uz"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
